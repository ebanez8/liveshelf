<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.2.0</Version>
    <AssemblyTitle>Live Shelf</AssemblyTitle>
    <Product>Live Shelf</Product>
    <Description>Windows-native shelf for turning hidden windows into live task cards.</Description>
    <Authors>Live Shelf contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiveShelf.Bridge\LiveShelf.Bridge.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\LiveShelf.Agent\LiveShelf.Agent.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyLiveShelfTools" AfterTargets="Build">
    <ItemGroup>
      <LiveShelfBridgeOutput Include="..\LiveShelf.Bridge\bin\$(Configuration)\net8.0\liveshelf-bridge.*" />
      <LiveShelfBridgeOutput Include="..\LiveShelf.Bridge\$(OutputPath)liveshelf-bridge.*" />
      <LiveShelfAgentOutput Include="..\LiveShelf.Agent\bin\$(Configuration)\net8.0\liveshelf-agent.*" />
      <LiveShelfAgentOutput Include="..\LiveShelf.Agent\$(OutputPath)liveshelf-agent.*" />
    </ItemGroup>
    <Copy SourceFiles="@(LiveShelfBridgeOutput)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(LiveShelfBridgeOutput.Identity)') and !Exists('$(OutDir)liveshelf-bridge.dll')" />
    <Copy SourceFiles="@(LiveShelfAgentOutput)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(LiveShelfAgentOutput.Identity)') and !Exists('$(OutDir)liveshelf-agent.dll')" />
  </Target>

  <Target Name="RemoveReleaseSymbolsFromPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PublishedSymbols Include="$(PublishDir)**\*.pdb" />
      <PublishedDiagnostics Include="$(PublishDir)createdump.exe" />
      <PublishedDiagnostics Include="$(PublishDir)mscordbi.dll" />
      <PublishedDiagnostics Include="$(PublishDir)mscordaccore.dll" />
      <PublishedDiagnostics Include="$(PublishDir)mscordaccore_*.dll" />
      <PublishedSatelliteDirs Include="$(PublishDir)cs" />
      <PublishedSatelliteDirs Include="$(PublishDir)de" />
      <PublishedSatelliteDirs Include="$(PublishDir)es" />
      <PublishedSatelliteDirs Include="$(PublishDir)fr" />
      <PublishedSatelliteDirs Include="$(PublishDir)it" />
      <PublishedSatelliteDirs Include="$(PublishDir)ja" />
      <PublishedSatelliteDirs Include="$(PublishDir)ko" />
      <PublishedSatelliteDirs Include="$(PublishDir)pl" />
      <PublishedSatelliteDirs Include="$(PublishDir)pt-BR" />
      <PublishedSatelliteDirs Include="$(PublishDir)ru" />
      <PublishedSatelliteDirs Include="$(PublishDir)tr" />
      <PublishedSatelliteDirs Include="$(PublishDir)zh-Hans" />
      <PublishedSatelliteDirs Include="$(PublishDir)zh-Hant" />
    </ItemGroup>
    <Delete Files="@(PublishedSymbols)" />
    <Delete Files="@(PublishedDiagnostics)" />
    <RemoveDir Directories="@(PublishedSatelliteDirs)" />
  </Target>

</Project>
