<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiveShelf.Bridge\LiveShelf.Bridge.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyLiveShelfBridge" AfterTargets="Build">
    <ItemGroup>
      <LiveShelfBridgeOutput Include="..\LiveShelf.Bridge\bin\$(Configuration)\net8.0\liveshelf-bridge.*" />
      <LiveShelfBridgeOutput Include="..\LiveShelf.Bridge\$(OutputPath)liveshelf-bridge.*" />
    </ItemGroup>
    <Copy SourceFiles="@(LiveShelfBridgeOutput)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(LiveShelfBridgeOutput.Identity)') and !Exists('$(OutDir)liveshelf-bridge.dll')" />
  </Target>

</Project>
