<Window x:Class="LiveShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Shelf"
        Width="264"
        Height="720"
        MinWidth="12"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#15181E"
        Foreground="#EEF2F7"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#20252D"/>
        <SolidColorBrush x:Key="CardBorder" Color="#343C48"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9DA7B5"/>

        <Style x:Key="MediaProgressStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Foreground" Value="#5FDCD5"/>
            <Setter Property="Background" Value="#121820"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="2.5"/>
                            <Border x:Name="PART_Track"
                                    Background="Transparent"/>
                            <Decorator x:Name="PART_Indicator"
                                       HorizontalAlignment="Left">
                                <Border Background="{TemplateBinding Foreground}"
                                        CornerRadius="2.5"/>
                            </Decorator>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Foreground" Value="#EEF2F7"/>
            <Setter Property="Background" Value="#20252D"/>
        </Style>

        <Style x:Key="HeaderActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Background" Value="#252C35"/>
            <Setter Property="BorderBrush" Value="#3E4856"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#EEF2F7"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#303946"/>
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#5F6D80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#1E252D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AgentContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#20252D"/>
            <Setter Property="BorderBrush" Value="#3E4856"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#EEF2F7"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootSurface"
            BorderBrush="#303844"
            BorderThickness="1,0,0,0"
            Background="#15181E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="12,12,12,8" LastChildFill="False">
                <TextBlock Text="Live Shelf"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Right"
                        MinWidth="24"
                        Height="22"
                        CornerRadius="11"
                        Background="#2A3039"
                        Padding="7,2">
                    <TextBlock Text="{Binding ItemCount}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <Button DockPanel.Dock="Right"
                        Margin="0,0,8,0"
                        Style="{StaticResource HeaderActionButtonStyle}"
                        ToolTip="Connect Codex or Claude Code hooks"
                        Click="AgentsButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#5FDCD5"
                                CornerRadius="4"
                                Padding="4,1"
                                Margin="0,0,6,0">
                            <TextBlock Text="AI"
                                       Foreground="#101318"
                                       FontSize="9"
                                       FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="Connect"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource AgentContextMenuStyle}">
                            <MenuItem Header="Connect Codex"
                                      Style="{StaticResource MenuItemStyle}"
                                      Click="EnableCodexTrackingMenuItem_Click"/>
                            <MenuItem Header="Connect Claude Code"
                                      Style="{StaticResource MenuItemStyle}"
                                      Click="EnableClaudeTrackingMenuItem_Click"/>
                            <Separator/>
                            <MenuItem Header="Connect Codex and Claude"
                                      Style="{StaticResource MenuItemStyle}"
                                      Click="EnableAllAgentTrackingMenuItem_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          Margin="8,0,8,8"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Tag="{Binding}"
                                    Margin="0,0,0,8"
                                    Padding="9"
                                    Background="{StaticResource CardBackground}"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Cursor="Hand"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5"
                                    Loaded="Card_Loaded"
                                    Unloaded="Card_Unloaded"
                                    MouseLeftButtonUp="Card_MouseLeftButtonUp"
                                    MouseEnter="Card_MouseEnter"
                                    MouseLeave="Card_MouseLeave"
                                    MouseWheel="Card_MouseWheel"
                                    IsManipulationEnabled="True"
                                    ManipulationStarting="Card_ManipulationStarting"
                                    ManipulationDelta="Card_ManipulationDelta">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Restore"
                                                  Style="{StaticResource MenuItemStyle}"
                                                  Click="RestoreMenuItem_Click"/>
                                        <MenuItem Header="Close Source"
                                                  Style="{StaticResource MenuItemStyle}"
                                                  Click="CloseSourceMenuItem_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Remove Card"
                                                  Style="{StaticResource MenuItemStyle}"
                                                  Click="RemoveCardMenuItem_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="{Binding CardTitle}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding StatusText}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding StatusTextVisibility}"/>

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding DetailText}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding DetailTextVisibility}"/>

                                        <ProgressBar Grid.Row="3"
                                                     Grid.Column="0"
                                                     Grid.ColumnSpan="2"
                                                     Margin="0,6,0,0"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding MediaProgressPercent, Mode=OneWay}"
                                                     Style="{StaticResource MediaProgressStyle}"
                                                     Visibility="{Binding MediaProgressVisibility}"/>

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,1,0">
                                            <Border Background="{Binding BadgeBrush}"
                                                    CornerRadius="7"
                                                    Padding="6,2"
                                                    Margin="0,0,7,0"
                                                    Visibility="{Binding BadgeVisibility}">
                                                <TextBlock Text="{Binding BadgeText}"
                                                           Foreground="#101318"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="148"/>
                                            </Border>
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding StatusBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <Border x:Name="PreviewSurface"
                                                Tag="{Binding}"
                                                Height="108"
                                                Focusable="True"
                                                Background="#090B0E"
                                                BorderBrush="#11151A"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                ClipToBounds="True"
                                                Loaded="PreviewSurface_Loaded"
                                                Unloaded="PreviewSurface_Unloaded"
                                                SizeChanged="PreviewSurface_SizeChanged"
                                                MouseLeftButtonDown="PreviewSurface_MouseLeftButtonDown"
                                                MouseLeftButtonUp="PreviewSurface_MouseLeftButtonUp"
                                                MouseRightButtonDown="PreviewSurface_MouseRightButtonDown"
                                                MouseRightButtonUp="PreviewSurface_MouseRightButtonUp"
                                                MouseMove="PreviewSurface_MouseMove"
                                                MouseWheel="PreviewSurface_MouseWheel"
                                                KeyDown="PreviewSurface_KeyDown"
                                                KeyUp="PreviewSurface_KeyUp"
                                                TextInput="PreviewSurface_TextInput"/>

                                        <Border Background="#99090B0E"
                                                CornerRadius="5"
                                                Visibility="{Binding ClosedOverlayVisibility}">
                                            <TextBlock Text="Window closed"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="2"
                       Text="{Binding StatusMessage}"
                       Margin="12,0,12,12"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
