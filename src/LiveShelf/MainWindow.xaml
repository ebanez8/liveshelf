<Window x:Class="LiveShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Shelf"
        Width="256"
        Height="720"
        MinWidth="12"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="Transparent"
        Foreground="#EEF2F7"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        MouseEnter="Window_MouseEnter"
        PreviewMouseMove="Window_PreviewMouseMove"
        MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#6E2B3038"/>
        <SolidColorBrush x:Key="CardBorder" Color="#32FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#98A3B1"/>

        <Style x:Key="MediaProgressStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="#F3F7FA"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid ClipToBounds="False">
                            <Border Background="{TemplateBinding Background}"
                                    Height="5"
                                    CornerRadius="2.5"
                                    VerticalAlignment="Center"/>
                            <Border x:Name="PART_Track"
                                    Background="Transparent"/>
                            <Decorator x:Name="PART_Indicator"
                                       HorizontalAlignment="Left">
                                <Grid ClipToBounds="False">
                                    <Border Background="{TemplateBinding Foreground}"
                                            Height="5"
                                            CornerRadius="2.5"
                                            VerticalAlignment="Center"/>
                                    <Ellipse Width="12"
                                             Height="12"
                                             Fill="{TemplateBinding Foreground}"
                                             Stroke="#30000000"
                                             StrokeThickness="1"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Center"
                                             Margin="0,0,-6,0"/>
                                </Grid>
                            </Decorator>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass Menu Item -->
        <Style x:Key="GlassMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#C8D8EA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="8"
                                Margin="2,1"
                                Padding="11,8">
                            <DockPanel x:Name="ItemContent"
                                       TextElement.Foreground="#C8D8EA">
                                <ContentPresenter DockPanel.Dock="Left"
                                                  ContentSource="Icon"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#18FFFFFF"/>
                                <Setter TargetName="ItemContent" Property="TextElement.Foreground" Value="#F0F6FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#252A30"/>
            <Setter Property="BorderBrush" Value="#202A33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#DCE5EC"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#313840" Offset="0"/>
                                    <GradientStop Color="#20252B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#3E4B55"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass Context Menu -->
        <Style x:Key="GlassContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Foreground" Value="#D0DEE8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Margin="10"
                                CornerRadius="12"
                                Padding="4,6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#D3232730" Offset="0"/>
                                    <GradientStop Color="#C8181C23" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#38FFFFFF" Offset="0"/>
                                    <GradientStop Color="#10FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.BorderThickness>
                                <Thickness>1</Thickness>
                            </Border.BorderThickness>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="6"
                                                  BlurRadius="28"
                                                  Opacity="0.55"
                                                  Color="#000000"
                                                  Direction="270"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass Separator -->
        <Style x:Key="GlassSeparatorStyle" TargetType="{x:Type Separator}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1"
                                Margin="14,5"
                                CornerRadius="0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                    <GradientStop Color="#18FFFFFF" Offset="0.15"/>
                                    <GradientStop Color="#18FFFFFF" Offset="0.85"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootSurface"
            BorderThickness="0"
            CornerRadius="12,0,0,12">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E31A1F25" Offset="0"/>
                <GradientStop Color="#D9151A20" Offset="0.48"/>
                <GradientStop Color="#E01E252C" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#66FFFFFF" Offset="0"/>
                <GradientStop Color="#24FFFFFF" Offset="0.5"/>
                <GradientStop Color="#08FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Grid.RowSpan="3"
                    Width="1"
                    HorizontalAlignment="Left"
                    Background="#32FFFFFF"
                    Opacity="0.55"
                    IsHitTestVisible="False"/>

            <DockPanel x:Name="HeaderSurface" Grid.Row="0" Margin="10,10,10,7" LastChildFill="False"
                       Visibility="{Binding FullShelfVisibility}">
                <TextBlock Text="Live Shelf"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Right"
                        MinWidth="24"
                        Height="20"
                        CornerRadius="10"
                        Background="#30363D"
                        Padding="6,1">
                    <TextBlock Text="{Binding ItemCount}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <Button DockPanel.Dock="Right"
                        Margin="0,0,7,0"
                        Style="{StaticResource HeaderActionButtonStyle}"
                        ToolTip="{Binding AgentConnectionToolTip}"
                        Click="AgentsButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{Binding AgentConnectionBrush}"
                                 Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding AgentConnectionText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource GlassContextMenuStyle}">
                            <MenuItem Header="Connect Codex"
                                      Style="{StaticResource GlassMenuItemStyle}"
                                      Click="EnableCodexTrackingMenuItem_Click">
                                <MenuItem.Icon>
                                    <Ellipse Width="7" Height="7" Fill="#50E3C2"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Connect Claude Code"
                                      Style="{StaticResource GlassMenuItemStyle}"
                                      Click="EnableClaudeTrackingMenuItem_Click">
                                <MenuItem.Icon>
                                    <Ellipse Width="7" Height="7" Fill="#F5A623"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{StaticResource GlassSeparatorStyle}"/>
                            <MenuItem Header="Connect Codex and Claude"
                                      Style="{StaticResource GlassMenuItemStyle}"
                                      Click="EnableAllAgentTrackingMenuItem_Click">
                                <MenuItem.Icon>
                                    <Ellipse Width="7" Height="7" Fill="#A78BFA"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </DockPanel>

            <ScrollViewer x:Name="FullShelfScroll"
                          Grid.Row="1"
                          Margin="7,0,7,7"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Visibility="{Binding FullShelfVisibility}">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Tag="{Binding}"
                                    Margin="0,0,0,7"
                                    Padding="7"
                                    Background="{StaticResource CardBackground}"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Cursor="Hand"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5"
                                    Loaded="Card_Loaded"
                                    Unloaded="Card_Unloaded"
                                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                                    MouseLeftButtonUp="Card_MouseLeftButtonUp"
                                    MouseEnter="Card_MouseEnter"
                                    MouseLeave="Card_MouseLeave"
                                    MouseMove="Card_MouseMove"
                                    MouseWheel="Card_MouseWheel"
                                    IsManipulationEnabled="True"
                                    ManipulationStarting="Card_ManipulationStarting"
                                    ManipulationDelta="Card_ManipulationDelta">
                                <Border.ContextMenu>
                                    <ContextMenu Style="{StaticResource GlassContextMenuStyle}">
                                        <MenuItem Header="Restore"
                                                  Style="{StaticResource GlassMenuItemStyle}"
                                                  Click="RestoreMenuItem_Click">
                                            <MenuItem.Icon>
                                                <Ellipse Width="7" Height="7" Fill="#5FDC8B"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Close Source"
                                                  Style="{StaticResource GlassMenuItemStyle}"
                                                  Click="CloseSourceMenuItem_Click">
                                            <MenuItem.Icon>
                                                <Ellipse Width="7" Height="7" Fill="#FFC457"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Style="{StaticResource GlassSeparatorStyle}"/>
                                        <MenuItem Header="Remove Card"
                                                  Style="{StaticResource GlassMenuItemStyle}"
                                                  Click="RemoveCardMenuItem_Click">
                                            <MenuItem.Icon>
                                                <Ellipse Width="7" Height="7" Fill="#EE6975"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          Height="32"
                                          ClipToBounds="True"
                                          Margin="0,0,0,5"
                                          Visibility="{Binding HeaderVisibility}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="16"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="0"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="{Binding CardTitle}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding StatusText}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10"
                                                   Margin="0,2,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HeaderStatusTextVisibility}"/>

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding DetailText}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10"
                                                   Margin="0,1,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HeaderDetailTextVisibility}"/>

                                        <ProgressBar Grid.Row="3"
                                                     Grid.Column="0"
                                                     Grid.ColumnSpan="2"
                                                     Margin="0,3,0,0"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding MediaProgressPercent, Mode=OneWay}"
                                                     Style="{StaticResource MediaProgressStyle}"
                                                     Visibility="{Binding HeaderMediaProgressVisibility}"/>

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,1,0">
                                            <Border Background="{Binding BadgeBrush}"
                                                    CornerRadius="5"
                                                    Padding="5,1"
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding BadgeVisibility}">
                                                <TextBlock Text="{Binding BadgeText}"
                                                           Foreground="#101318"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="128"/>
                                            </Border>
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding BadgeDotBrush}"
                                                     Visibility="{Binding BadgeDotVisibility}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <Grid x:Name="PreviewHost"
                                              Tag="{Binding}"
                                              Height="92"
                                              ClipToBounds="True"
                                              Loaded="PreviewHost_Loaded"
                                              Unloaded="PreviewHost_Unloaded"
                                              SizeChanged="PreviewHost_SizeChanged"
                                              Visibility="{Binding PreviewVisibility}">
                                            <Border x:Name="PreviewSurface"
                                                    Tag="{Binding}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    MinWidth="1"
                                                    MinHeight="1"
                                                    Background="Transparent"
                                                    BorderBrush="#28FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    ClipToBounds="True"
                                                    Loaded="PreviewSurface_Loaded"
                                                    Unloaded="PreviewSurface_Unloaded"
                                                    SizeChanged="PreviewSurface_SizeChanged"
                                                    MouseWheel="PreviewSurface_MouseWheel"/>
                                        </Grid>

                                        <Border Background="Transparent"
                                                CornerRadius="4"
                                                Padding="2,1,2,0"
                                                Visibility="{Binding MediaInfoVisibility}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding MediaSourceTitle}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding StatusText}"
                                                           Foreground="#EEF2F7"
                                                           FontSize="10"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding DetailText}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="10"
                                                           Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Grid.Row="3"
                                                             Margin="0,8,0,0"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding MediaProgressPercent, Mode=OneWay}"
                                                             Style="{StaticResource MediaProgressStyle}"
                                                             Visibility="{Binding MediaProgressVisibility}"/>
                                            </Grid>
                                        </Border>

                                        <Border Background="#C40B0D11"
                                                CornerRadius="4"
                                                Padding="12"
                                                Visibility="{Binding StatusOnlyPreviewVisibility}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding CardTitle}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Title}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="10"
                                                           Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding StatusText}"
                                                           Foreground="#EEF2F7"
                                                           FontSize="11"
                                                           Margin="0,9,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="3"
                                                           Text="{Binding DetailText}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="10"
                                                           Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Grid.Row="4"
                                                             VerticalAlignment="Bottom"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding MediaProgressPercent, Mode=OneWay}"
                                                             Style="{StaticResource MediaProgressStyle}"
                                                             Visibility="{Binding MediaProgressVisibility}"/>
                                                <DockPanel Grid.Row="5"
                                                           LastChildFill="True"
                                                           Margin="0,10,0,0">
                                                    <Button DockPanel.Dock="Right"
                                                            Tag="{Binding}"
                                                            Content="Restore"
                                                            Style="{StaticResource HeaderActionButtonStyle}"
                                                            Click="FallbackRestoreButton_Click"/>
                                                    <TextBlock Text="{Binding PreviewStatusReason}"
                                                               Foreground="{StaticResource TextMuted}"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,10,0"/>
                                                </DockPanel>
                                            </Grid>
                                        </Border>

                                        <Border Background="#8C0B0D11"
                                                CornerRadius="4"
                                                Visibility="{Binding ClosedOverlayVisibility}">
                                            <TextBlock Text="Window closed"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="StatusSurface"
                       Grid.Row="2"
                       Text="{Binding StatusMessage}"
                       Margin="10,0,10,10"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="10"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding FullShelfVisibility}"/>

            <!-- Collapsed Rail (icon strip) -->
            <Border x:Name="RailSurface"
                    Grid.Row="0" Grid.RowSpan="3"
                    Width="48"
                    HorizontalAlignment="Right"
                    Padding="0,14"
                    Background="Transparent"
                    BorderThickness="0"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5"
                    Visibility="{Binding RailVisibility}"
                    MouseEnter="RailSurface_MouseEnter">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                        <TranslateTransform X="-10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="36" Height="36" Margin="0,2"
                                  Cursor="Hand"
                                  ToolTip="{Binding CardTitle}"
                                  Tag="{Binding}"
                                  MouseLeftButtonUp="RailIcon_MouseLeftButtonUp">
                                <Border CornerRadius="8"
                                        Background="#18FFFFFF"
                                        Width="32" Height="32">
                                    <Image Source="{Binding AppIcon}"
                                           Width="22" Height="22"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <Ellipse Width="9" Height="9"
                                         Fill="{Binding BadgeDotBrush}"
                                         Visibility="{Binding BadgeDotVisibility}"
                                         Stroke="#20000000"
                                         StrokeThickness="1.5"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,3,3"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Border>
</Window>
