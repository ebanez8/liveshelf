<Window x:Class="LiveShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Shelf"
        Width="256"
        Height="720"
        MinWidth="12"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#101317"
        Foreground="#EEF2F7"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#181D23"/>
        <SolidColorBrush x:Key="CardBorder" Color="#262E37"/>
        <SolidColorBrush x:Key="TextMuted" Color="#98A3B1"/>

        <Style x:Key="MediaProgressStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Foreground" Value="#59D6CE"/>
            <Setter Property="Background" Value="#0D1116"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="2"/>
                            <Border x:Name="PART_Track"
                                    Background="Transparent"/>
                            <Decorator x:Name="PART_Indicator"
                                       HorizontalAlignment="Left">
                                <Border Background="{TemplateBinding Foreground}"
                                        CornerRadius="2"/>
                            </Decorator>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Foreground" Value="#EEF2F7"/>
            <Setter Property="Background" Value="#181D23"/>
        </Style>

        <Style x:Key="HeaderActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="23"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="#191F26"/>
            <Setter Property="BorderBrush" Value="#29323C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#EEF2F7"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#222A33"/>
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#394553"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#141A20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AgentContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#181D23"/>
            <Setter Property="BorderBrush" Value="#2D3642"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#EEF2F7"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootSurface"
            BorderBrush="#303844"
            BorderThickness="1,0,0,0"
            Background="#101317">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="10,10,10,7" LastChildFill="False">
                <TextBlock Text="Live Shelf"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Right"
                        MinWidth="24"
                        Height="20"
                        CornerRadius="10"
                        Background="#1B2128"
                        Padding="6,1">
                    <TextBlock Text="{Binding ItemCount}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <Button DockPanel.Dock="Right"
                        Margin="0,0,7,0"
                        Style="{StaticResource HeaderActionButtonStyle}"
                        ToolTip="{Binding AgentConnectionToolTip}"
                        Click="AgentsButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{Binding AgentConnectionBrush}"
                                 Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding AgentConnectionText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource AgentContextMenuStyle}">
                            <MenuItem Header="Connect Codex"
                                      Style="{StaticResource MenuItemStyle}"
                                      Click="EnableCodexTrackingMenuItem_Click"/>
                            <MenuItem Header="Test Codex Hook"
                                      Style="{StaticResource MenuItemStyle}"
                                      Click="TestCodexTrackingMenuItem_Click"/>
                            <MenuItem Header="Connect Claude Code"
                                      Style="{StaticResource MenuItemStyle}"
                                      Click="EnableClaudeTrackingMenuItem_Click"/>
                            <MenuItem Header="Test Claude Hook"
                                      Style="{StaticResource MenuItemStyle}"
                                      Click="TestClaudeTrackingMenuItem_Click"/>
                            <Separator/>
                            <MenuItem Header="Connect Codex and Claude"
                                      Style="{StaticResource MenuItemStyle}"
                                      Click="EnableAllAgentTrackingMenuItem_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          Margin="7,0,7,7"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Tag="{Binding}"
                                    Margin="0,0,0,7"
                                    Padding="7"
                                    Background="{StaticResource CardBackground}"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Cursor="Hand"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5"
                                    Loaded="Card_Loaded"
                                    Unloaded="Card_Unloaded"
                                    MouseLeftButtonUp="Card_MouseLeftButtonUp"
                                    MouseEnter="Card_MouseEnter"
                                    MouseLeave="Card_MouseLeave"
                                    MouseWheel="Card_MouseWheel"
                                    IsManipulationEnabled="True"
                                    ManipulationStarting="Card_ManipulationStarting"
                                    ManipulationDelta="Card_ManipulationDelta">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Restore"
                                                  Style="{StaticResource MenuItemStyle}"
                                                  Click="RestoreMenuItem_Click"/>
                                        <MenuItem Header="Close Source"
                                                  Style="{StaticResource MenuItemStyle}"
                                                  Click="CloseSourceMenuItem_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Remove Card"
                                                  Style="{StaticResource MenuItemStyle}"
                                                  Click="RemoveCardMenuItem_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,7">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="{Binding CardTitle}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding StatusText}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding StatusTextVisibility}"/>

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding DetailText}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding DetailTextVisibility}"/>

                                        <ProgressBar Grid.Row="3"
                                                     Grid.Column="0"
                                                     Grid.ColumnSpan="2"
                                                     Margin="0,5,0,0"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding MediaProgressPercent, Mode=OneWay}"
                                                     Style="{StaticResource MediaProgressStyle}"
                                                     Visibility="{Binding MediaProgressVisibility}"/>

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,1,0">
                                            <Border Background="{Binding BadgeBrush}"
                                                    CornerRadius="5"
                                                    Padding="5,1"
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding BadgeVisibility}">
                                                <TextBlock Text="{Binding BadgeText}"
                                                           Foreground="#101318"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="128"/>
                                            </Border>
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding StatusBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <Border x:Name="PreviewSurface"
                                                Tag="{Binding}"
                                                Height="108"
                                                Focusable="True"
                                                Background="#090B0E"
                                                BorderBrush="#0D1117"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                ClipToBounds="True"
                                                Loaded="PreviewSurface_Loaded"
                                                Unloaded="PreviewSurface_Unloaded"
                                                SizeChanged="PreviewSurface_SizeChanged"
                                                MouseLeftButtonDown="PreviewSurface_MouseLeftButtonDown"
                                                MouseLeftButtonUp="PreviewSurface_MouseLeftButtonUp"
                                                MouseRightButtonDown="PreviewSurface_MouseRightButtonDown"
                                                MouseRightButtonUp="PreviewSurface_MouseRightButtonUp"
                                                MouseMove="PreviewSurface_MouseMove"
                                                MouseWheel="PreviewSurface_MouseWheel"
                                                KeyDown="PreviewSurface_KeyDown"
                                                KeyUp="PreviewSurface_KeyUp"
                                                TextInput="PreviewSurface_TextInput"/>

                                        <Border Background="#F0090B0E"
                                                CornerRadius="4"
                                                Padding="12"
                                                Visibility="{Binding StatusOnlyPreviewVisibility}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding CardTitle}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Title}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="10"
                                                           Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding StatusText}"
                                                           Foreground="#EEF2F7"
                                                           FontSize="11"
                                                           Margin="0,9,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="3"
                                                           Text="{Binding DetailText}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="10"
                                                           Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Grid.Row="4"
                                                             VerticalAlignment="Bottom"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding MediaProgressPercent, Mode=OneWay}"
                                                             Style="{StaticResource MediaProgressStyle}"
                                                             Visibility="{Binding MediaProgressVisibility}"/>
                                                <DockPanel Grid.Row="5"
                                                           LastChildFill="True"
                                                           Margin="0,10,0,0">
                                                    <Button DockPanel.Dock="Right"
                                                            Tag="{Binding}"
                                                            Content="Restore"
                                                            Style="{StaticResource HeaderActionButtonStyle}"
                                                            Click="FallbackRestoreButton_Click"/>
                                                    <TextBlock Text="{Binding PreviewStatusReason}"
                                                               Foreground="{StaticResource TextMuted}"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,10,0"/>
                                                </DockPanel>
                                            </Grid>
                                        </Border>

                                        <Border Background="#99090B0E"
                                                CornerRadius="4"
                                                Visibility="{Binding ClosedOverlayVisibility}">
                                            <TextBlock Text="Window closed"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="2"
                       Text="{Binding StatusMessage}"
                       Margin="10,0,10,10"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="10"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
